{% extends "base.html" %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Промокоды - VPN Bot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #f2f2f7; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
        .header h1 { font-size: 28px; font-weight: 700; color: #1c1c1e; margin: 0; }
        .header h1 i { color: #007aff; margin-right: 10px; }
        .card { background: white; border-radius: 16px; box-shadow: 0 2px 20px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 20px; }
        .card-header { padding: 16px 20px; border-bottom: 1px solid #e5e5ea; font-weight: 600; font-size: 16px; display: flex; justify-content: space-between; align-items: center; }
        .card-body { padding: 20px; overflow-x: auto; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-weight: 500; color: #1c1c1e; margin-bottom: 4px; font-size: 14px; }
        .form-group .help-text { color: #8e8e93; font-size: 12px; margin-top: 4px; }
        .form-control { width: 100%; padding: 10px 14px; border: 1px solid #d1d1d6; border-radius: 10px; font-size: 14px; background: white; transition: border-color 0.2s; }
        .form-control:focus { outline: none; border-color: #007aff; box-shadow: 0 0 0 4px rgba(0, 122, 255, 0.1); }
        select.form-control { appearance: auto; }
        .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .btn { padding: 10px 20px; border: none; border-radius: 10px; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.2s; text-decoration: none; display: inline-block; }
        .btn:hover { transform: scale(0.97); }
        .btn-primary { background: #007aff; color: white; }
        .btn-primary:hover { background: #0066d9; }
        .btn-danger { background: #ff3b30; color: white; }
        .btn-danger:hover { background: #e0352b; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        table th { text-align: left; padding: 12px 16px; background: #f8f8fc; font-weight: 600; color: #8e8e93; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px; }
        table td { padding: 12px 16px; border-bottom: 1px solid #f2f2f7; }
        table tr:hover td { background: #f8f8fc; }
        .badge { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; display: inline-block; }
        .badge-success { background: #e8f5e9; color: #2e7d32; }
        .badge-danger { background: #ffebee; color: #c62828; }
        .badge-info { background: #e3f2fd; color: #0d47a1; }
        .badge-warning { background: #fff3e0; color: #e65100; }
        .badge-purple { background: #f3e5f5; color: #4a148c; }
        .badge-secondary { background: #f5f5f5; color: #616161; }
        .back-link { color: #007aff; text-decoration: none; font-weight: 500; }
        .back-link:hover { text-decoration: underline; }
        .hidden { display: none; }
        .alert { padding: 12px 16px; border-radius: 12px; margin-bottom: 16px; font-weight: 500; }
        .alert-success { background: #e8f5e9; color: #2e7d32; }
        .trigger-info { background: #f8f8fc; padding: 12px 16px; border-radius: 10px; margin-top: 8px; font-size: 13px; }
        @media (max-width: 768px) { .row { grid-template-columns: 1fr; } .header { flex-direction: column; align-items: flex-start; } }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-ticket-alt"></i> Промокоды</h1>
            <a href="/dashboard" class="back-link">← Вернуться в дашборд</a>
        </div>

        {% if request.query_params.get('saved') %}
        <div class="alert alert-success">✅ Промокод создан!</div>
        {% endif %}
        {% if request.query_params.get('deleted') %}
        <div class="alert alert-success">✅ Промокод удалён!</div>
        {% endif %}

        <div class="card">
            <div class="card-header"><span>➕ Создать промокод</span></div>
            <div class="card-body">
                <form method="POST" action="/promocodes/add">
                    <div class="row">
                        <div class="form-group">
                            <label>Код промокода</label>
                            <input type="text" class="form-control" name="code" placeholder="Введите код" required>
                        </div>
                        <div class="form-group">
                            <label>Тип активации</label>
                            <select class="form-control" name="trigger_type" id="trigger_type" onchange="toggleTriggerParams()" required>
                                <option value="manual">✋ Ручная активация</option>
                                <option value="referrals">👥 Рефералы</option>
                                <option value="purchases">🛒 Покупки</option>
                                <option value="subscription_days">📅 Дни подписки</option>
                                <option value="first_payment">💳 Первая оплата</option>
                            </select>
                        </div>
                    </div>

                    <div id="trigger_params" class="hidden">
                        <div class="row">
                            <div class="form-group">
                                <label>Целевое значение</label>
                                <input type="number" class="form-control" name="trigger_target" placeholder="Например: 5" min="1">
                            </div>
                            <div class="form-group">
                                <label>Описание триггера</label>
                                <input type="text" class="form-control" name="trigger_description" placeholder="Описание для пользователя" value="Достижение цели">
                            </div>
                        </div>
                        <div class="trigger-info" id="trigger_info">
                            <span>ℹ️ </span>
                            <span id="trigger_description">При достижении цели промокод активируется автоматически</span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group">
                            <label>Скидка (%)</label>
                            <input type="number" class="form-control" name="discount_percent" placeholder="30" min="0" max="100">
                        </div>
                        <div class="form-group">
                            <label>Скидка (₽)</label>
                            <input type="number" class="form-control" name="discount_amount" placeholder="200" min="0" step="0.01">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group">
                            <label>Максимальное использование</label>
                            <input type="number" class="form-control" name="max_uses" placeholder="100" value="1" min="1">
                        </div>
                        <div class="form-group">
                            <label>Действителен до</label>
                            <input type="datetime-local" class="form-control" name="valid_until">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">✅ Создать промокод</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span>📋 Список промокодов</span>
                <span style="font-size:12px; color:#8e8e93;">Всего: {{ promocodes|length }}</span>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th>Код</th>
                            <th>Скидка</th>
                            <th>Тип</th>
                            <th>Использовано</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for promo in promocodes %}
                        <tr>
                            <td><code>{{ promo[1] }}</code></td>
                            <td><div style="display:flex; gap:5px;">
                                {% if promo[2] > 0 %}{{ promo[2] }}%{% endif %}
                                {% if promo[3] > 0 %}{{ promo[3] }}₽{% endif %}
                                {% if promo[2] == 0 and promo[3] == 0 %}0{% endif %}
                            </td>
                            <td><div style="display:flex; gap:5px;">
                                {% if promo[7] == 'manual' %}
                                <span class="badge badge-secondary">✋ Ручной</span>
                                {% elif promo[7] == 'referrals' %}
                                <span class="badge badge-info">👥 Рефералы</span>
                                {% elif promo[7] == 'purchases' %}
                                <span class="badge badge-warning">🛒 Покупки</span>
                                {% elif promo[7] == 'subscription_days' %}
                                <span class="badge badge-purple">📅 Дни подписки</span>
                                {% elif promo[7] == 'first_payment' %}
                                <span class="badge badge-success">💳 Первая оплата</span>
                                {% else %}
                                <span class="badge badge-secondary">{{ promo[7] }}</span>
                                {% endif %}
                            </td>
                            <td>{{ promo[6] }}/{{ promo[5] }}</td>
                            <td><div style="display:flex; gap:5px;">
                                {% if promo[8] == 1 %}
                                <span class="badge badge-success">✅ Активен</span>
                                {% else %}
                                <span class="badge badge-danger">❌ Неактивен</span>
                                {% endif %}
                            </td>
                            <td><div style="display:flex; gap:5px;">
        <a href="/promocodes/edit/{{ promo[0] }}" class="btn btn-primary btn-sm">✏️</a>
                                <form method="POST" action="/promocodes/delete/{{ promo[0] }}" style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Удалить промокод?')">🗑</button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function toggleTriggerParams() {
            const triggerType = document.getElementById('trigger_type').value;
            const paramsDiv = document.getElementById('trigger_params');
            const descriptionSpan = document.getElementById('trigger_description');
            
            const descriptions = {
                'manual': 'Промокод активируется вручную администратором',
                'referrals': 'Пригласите указанное количество друзей по реферальной ссылке',
                'purchases': 'Совершите указанное количество покупок в боте',
                'subscription_days': 'Наберите указанное количество дней с активной подпиской',
                'first_payment': 'Промокод активируется после первой оплаты'
            };

            if (triggerType === 'manual') {
                paramsDiv.classList.add('hidden');
            } else {
                paramsDiv.classList.remove('hidden');
                descriptionSpan.textContent = descriptions[triggerType] || 'При достижении цели промокод активируется автоматически';
            }
        }
        document.addEventListener('DOMContentLoaded', toggleTriggerParams);
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</body>
</html>
{% endblock %}
