<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VPN Bot Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ============================================================
           СТИЛЬ 3X-UI
           ============================================================ */

        /* --- Общие --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-primary: #0d1117;
            --bg-secondary: #161b22;
            --bg-card: #1c2333;
            --bg-hover: #252d3f;
            --text-primary: #e6edf3;
            --text-secondary: #8b949e;
            --text-muted: #484f58;
            --border-color: #30363d;
            --accent: #2d7cf6;
            --accent-hover: #1a6ad5;
            --success: #3fb950;
            --danger: #f85149;
            --warning: #d29922;
            --shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
            --radius: 8px;
            --transition: 0.2s ease;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-secondary);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--text-muted);
        }

        /* --- Сайдбар (как в 3x-ui) --- */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 240px;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border-color);
            padding: 16px 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            transition: none;
        }

        .sidebar .logo {
            padding: 0 16px 24px 16px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar .logo i {
            font-size: 28px;
            color: var(--accent);
        }

        .sidebar .logo span {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.5px;
        }

        .sidebar .logo small {
            font-size: 11px;
            color: var(--text-secondary);
            font-weight: 400;
            display: block;
        }

        .sidebar .nav {
            flex: 1;
            padding: 0 8px;
        }

        .sidebar .nav-section {
            color: var(--text-muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 8px 12px 4px 12px;
            font-weight: 600;
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 12px;
            border-radius: var(--radius);
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all var(--transition);
            margin-bottom: 1px;
        }

        .sidebar .nav-link i {
            width: 20px;
            text-align: center;
            font-size: 16px;
        }

        .sidebar .nav-link:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        .sidebar .nav-link.active {
            background: var(--accent);
            color: #fff;
        }

        .sidebar .nav-link.active i {
            color: #fff;
        }

        .sidebar .nav-link.text-danger {
            color: var(--danger);
        }

        .sidebar .nav-link.text-danger:hover {
            background: rgba(248, 81, 73, 0.15);
            color: var(--danger);
        }

        .sidebar .sidebar-footer {
            padding: 16px;
            border-top: 1px solid var(--border-color);
            margin-top: auto;
            font-size: 12px;
            color: var(--text-muted);
            text-align: center;
        }

        /* --- Контент --- */
        .main-content {
            margin-left: 240px;
            padding: 24px 32px;
            min-height: 100vh;
            width: calc(100% - 240px);
            flex: 1;
        }

        /* --- Карточки (как в 3x-ui) --- */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            margin-bottom: 20px;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            font-size: 14px;
            color: var(--text-primary);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-body {
            padding: 20px;
        }

        /* --- Статистика (Dashboard) --- */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 16px 20px;
            text-align: center;
            box-shadow: var(--shadow);
        }

        .stat-card .number {
            font-size: 28px;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .stat-card .label {
            font-size: 13px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .stat-card .icon {
            font-size: 20px;
            color: var(--accent);
            margin-bottom: 4px;
        }

        /* --- Таблицы (как в 3x-ui) --- */
        .table-wrapper {
            overflow-x: auto;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .table th {
            text-align: left;
            padding: 10px 14px;
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            border-bottom: 1px solid var(--border-color);
            background: var(--bg-secondary);
        }

        .table td {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
            vertical-align: middle;
        }

        .table tr:hover td {
            background: var(--bg-hover);
        }

        /* --- Формы --- */
        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-weight: 500;
            color: var(--text-secondary);
            font-size: 13px;
            margin-bottom: 4px;
        }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            color: var(--text-primary);
            font-size: 14px;
            transition: all var(--transition);
            outline: none;
        }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(45, 124, 246, 0.2);
        }

        .form-control[readonly] {
            opacity: 0.6;
            cursor: not-allowed;
        }

        select.form-control {
            appearance: auto;
            cursor: pointer;
        }

        /* --- Кнопки --- */
        .btn {
            padding: 8px 18px;
            border: none;
            border-radius: var(--radius);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

        .btn:hover {
            transform: scale(0.97);
        }

        .btn-primary {
            background: var(--accent);
            color: #fff;
        }
        .btn-primary:hover {
            background: var(--accent-hover);
        }

        .btn-success {
            background: var(--success);
            color: #fff;
        }
        .btn-success:hover {
            background: #2d8a3e;
        }

        .btn-danger {
            background: var(--danger);
            color: #fff;
        }
        .btn-danger:hover {
            background: #d43b33;
        }

        .btn-secondary {
            background: var(--bg-hover);
            color: var(--text-secondary);
        }
        .btn-secondary:hover {
            background: var(--border-color);
            color: var(--text-primary);
        }

        .btn-sm {
            padding: 4px 12px;
            font-size: 12px;
            border-radius: 6px;
        }

        .btn-group {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        /* --- Badges --- */
        .badge {
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 500;
            display: inline-block;
        }

        .badge-success {
            background: rgba(63, 185, 80, 0.2);
            color: var(--success);
        }
        .badge-danger {
            background: rgba(248, 81, 73, 0.2);
            color: var(--danger);
        }
        .badge-warning {
            background: rgba(210, 153, 34, 0.2);
            color: var(--warning);
        }
        .badge-info {
            background: rgba(45, 124, 246, 0.2);
            color: var(--accent);
        }
        .badge-secondary {
            background: var(--bg-hover);
            color: var(--text-secondary);
        }

        /* --- Alerts --- */
        .alert {
            padding: 12px 16px;
            border-radius: var(--radius);
            margin-bottom: 16px;
            font-weight: 500;
            border: 1px solid transparent;
        }
        .alert-success {
            background: rgba(63, 185, 80, 0.15);
            border-color: var(--success);
            color: var(--success);
        }
        .alert-danger {
            background: rgba(248, 81, 73, 0.15);
            border-color: var(--danger);
            color: var(--danger);
        }
        .alert-warning {
            background: rgba(210, 153, 34, 0.15);
            border-color: var(--warning);
            color: var(--warning);
        }

        /* --- Grid --- */
        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        /* --- Page Header --- */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

        .page-header h1 i {
            color: var(--accent);
            margin-right: 10px;
        }

        /* --- Collapsible (для достижений) --- */
        .collapse-header {
            cursor: pointer;
            user-select: none;
        }
        .collapse-header:hover {
            background: var(--bg-hover);
        }
        .collapse-body {
            display: block;
        }
        .collapse-body.hidden {
            display: none;
        }
        .collapse-icon {
            transition: transform 0.2s;
        }
        .collapse-icon.open {
            transform: rotate(180deg);
        }

        /* --- Мобильная адаптация --- */
        @media (max-width: 768px) {
            .sidebar {
                width: 0;
                overflow: hidden;
                padding: 0;
                transform: translateX(-100%);
            }
            .sidebar.open {
                width: 240px;
                padding: 16px 0;
                transform: translateX(0);
            }
            .main-content {
                margin-left: 0;
                width: 100%;
                padding: 16px;
            }
            .row {
                grid-template-columns: 1fr;
            }
            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }
            .page-header h1 {
                font-size: 20px;
            }
            .sidebar .logo span {
                display: block;
            }
        }

        @media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        /* --- Мобильное меню (гамбургер) --- */
        .menu-toggle {
            display: none;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 8px 12px;
            border-radius: var(--radius);
            cursor: pointer;
            font-size: 20px;
            margin-bottom: 16px;
        }

        @media (max-width: 768px) {
            .menu-toggle {
                display: inline-block;
            }
        }

        /* ============================================================
           ДОПОЛНИТЕЛЬНЫЕ СТИЛИ ДЛЯ КОНКРЕТНЫХ СТРАНИЦ
           ============================================================ */

        .back-link {
            color: var(--accent);
            text-decoration: none;
            font-weight: 500;
        }
        .back-link:hover {
            text-decoration: underline;
        }

        .text-muted {
            color: var(--text-muted);
        }

        .text-center {
            text-align: center;
        }

        .mt-2 { margin-top: 8px; }
        .mb-2 { margin-bottom: 8px; }
        .mt-3 { margin-top: 16px; }
        .mb-3 { margin-bottom: 16px; }

        /* --- Стили для страницы логина --- */
        .login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: var(--bg-primary);
            padding: 20px;
        }
        .login-box {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 40px;
            max-width: 400px;
            width: 100%;
            box-shadow: var(--shadow);
        }
        .login-box .logo {
            text-align: center;
            font-size: 48px;
            color: var(--accent);
            margin-bottom: 10px;
        }
        .login-box h1 {
            text-align: center;
            font-size: 24px;
            color: var(--text-primary);
            margin-bottom: 5px;
        }
        .login-box .subtitle {
            text-align: center;
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 30px;
        }
        .login-box .form-control {
            background: var(--bg-secondary);
        }
        .login-box .btn {
            width: 100%;
            justify-content: center;
            padding: 12px;
            font-size: 16px;
            margin-top: 10px;
        }
        .login-box .error {
            color: var(--danger);
            text-align: center;
            margin-bottom: 16px;
            padding: 10px;
            background: rgba(248, 81, 73, 0.15);
            border-radius: var(--radius);
        }
        .login-box .twofa-section {
            display: none;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }
        .login-box .twofa-section.show {
            display: block;
        }
        .login-box .twofa-section input {
            text-align: center;
            letter-spacing: 4px;
            font-size: 18px;
        }
    </style>
</head>
<body>

    <!-- ===== ГАМБУРГЕР (мобильная версия) ===== -->
    <button class="menu-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>

    <!-- ===== САЙДБАР ===== -->
    <nav class="sidebar" id="sidebar">
        <div class="logo">
            <i class="fas fa-shield-halved"></i>
            <div>
                <span>VPN Bot</span>
                <small>Admin Panel</small>
            </div>
        </div>

        <div class="nav">
            <div class="nav-section">Основное</div>
            <a class="nav-link {% if request.url.path == '/dashboard' %}active{% endif %}" href="/dashboard">
                <i class="fas fa-chart-simple"></i> Дашборд
            </a>
            <a class="nav-link {% if request.url.path == '/users' %}active{% endif %}" href="/users">
                <i class="fas fa-users"></i> Пользователи
            </a>
            <a class="nav-link {% if request.url.path == '/servers' %}active{% endif %}" href="/servers">
                <i class="fas fa-server"></i> Серверы
            </a>
            <a class="nav-link {% if request.url.path == '/tariffs' %}active{% endif %}" href="/tariffs">
                <i class="fas fa-tags"></i> Тарифы
            </a>

            <div class="nav-section">Финансы</div>
            <a class="nav-link {% if request.url.path == '/payments' %}active{% endif %}" href="/payments">
                <i class="fas fa-credit-card"></i> Оплаты
            </a>
            <a class="nav-link {% if request.url.path == '/promocodes' %}active{% endif %}" href="/promocodes">
                <i class="fas fa-ticket"></i> Промокоды
            </a>
            <a class="nav-link {% if request.url.path == '/achievements' %}active{% endif %}" href="/achievements">
                <i class="fas fa-trophy"></i> Достижения
            </a>

            <div class="nav-section">Инструменты</div>
            <a class="nav-link {% if request.url.path == '/broadcast' %}active{% endif %}" href="/broadcast">
                <i class="fas fa-bullhorn"></i> Рассылка
            </a>
            <a class="nav-link {% if request.url.path == '/analytics' %}active{% endif %}" href="/analytics">
                <i class="fas fa-chart-line"></i> Аналитика
            </a>
            <a class="nav-link {% if request.url.path == '/bot-texts' %}active{% endif %}" href="/bot-texts">
                <i class="fas fa-comment-dots"></i> Тексты
            </a>

            <div class="nav-section">Настройки</div>
            <a class="nav-link {% if request.url.path == '/settings' %}active{% endif %}" href="/settings">
                <i class="fas fa-gear"></i> Настройки
            </a>
            <a class="nav-link {% if request.url.path == '/tax-settings' %}active{% endif %}" href="/tax-settings">
                <i class="fas fa-receipt"></i> Налоги
            </a>
            <a class="nav-link {% if request.url.path == '/rate-limits' %}active{% endif %}" href="/rate-limits">
                <i class="fas fa-shield"></i> Защита
            </a>

            <div class="nav-section">Система</div>
            <a class="nav-link {% if request.url.path == '/backup' %}active{% endif %}" href="/backup">
                <i class="fas fa-archive"></i> Бэкап
            </a>
            <a class="nav-link {% if request.url.path == '/admin-logs' %}active{% endif %}" href="/admin-logs">
                <i class="fas fa-clock-rotate-left"></i> Логи
            </a>

            <div class="nav-section">Безопасность</div>
            <a class="nav-link {% if request.url.path == '/change-credentials' %}active{% endif %}" href="/change-credentials">
                <i class="fas fa-key"></i> Сменить логин
            </a>
            <a class="nav-link {% if request.url.path == '/2fa' %}active{% endif %}" href="/2fa">
                <i class="fas fa-shield-halved"></i> 2FA
            </a>
        </div>

        <div class="sidebar-footer">
            <i class="fas fa-circle" style="color: var(--success); font-size: 8px;"></i>
            Система работает
            <br>
            <span style="font-size: 11px;">v2.0</span>
        </div>
    </nav>

    <!-- ===== ОСНОВНОЙ КОНТЕНТ ===== -->
    <main class="main-content" id="mainContent">
        {% block content %}{% endblock %}
    </main>

    <script>
        // Боковое меню всегда открыто
        const sidebar = document.getElementById('sidebar');

        function toggleSidebar() {
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle('open');
            }
        }

        // Закрываем меню при клике на контент (мобильная версия)
        document.addEventListener('click', function(e) {
            if (window.innerWidth <= 768) {
                const main = document.getElementById('mainContent');
                if (main && main.contains(e.target) && !sidebar.contains(e.target)) {
                    sidebar.classList.remove('open');
                }
            }
        });

        // При загрузке убираем класс collapsed
        document.addEventListener('DOMContentLoaded', function() {
            sidebar.classList.remove('collapsed');
            if (window.innerWidth > 768) {
                sidebar.classList.remove('open');
            }
        });

        // Функция для сворачиваемых карточек
        function toggleCollapse(header) {
            const body = header.nextElementSibling;
            const icon = header.querySelector('.collapse-icon');
            if (body) {
                body.classList.toggle('hidden');
                if (icon) {
                    icon.classList.toggle('open');
                }
            }
        }
    </script>

</body>
</html>
