{% extends "base.html" %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Достижения - VPN Bot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #f2f2f7; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
        .header h1 { font-size: 28px; font-weight: 700; color: #1c1c1e; margin: 0; }
        .header h1 i { color: #007aff; margin-right: 10px; }
        .card { background: white; border-radius: 16px; box-shadow: 0 2px 20px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 20px; }
        .card-header { padding: 16px 20px; border-bottom: 1px solid #e5e5ea; font-weight: 600; font-size: 16px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none; }
        .card-header:hover { background: #f8f8fc; }
        .card-header .toggle-icon { transition: transform 0.3s; }
        .card-header .toggle-icon.open { transform: rotate(180deg); }
        .card-body { padding: 20px; overflow-x: auto; }
        .card-body.collapsed { display: none; }
        .badge { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; display: inline-block; }
        .badge-success { background: #e8f5e9; color: #2e7d32; }
        .badge-info { background: #e3f2fd; color: #0d47a1; }
        .badge-warning { background: #fff3e0; color: #e65100; }
        .badge-purple { background: #f3e5f5; color: #4a148c; }
        .badge-pink { background: #fce4ec; color: #880e4f; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        table th { text-align: left; padding: 12px 16px; background: #f8f8fc; font-weight: 600; color: #8e8e93; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px; }
        table td { padding: 12px 16px; border-bottom: 1px solid #f2f2f7; }
        table tr:hover td { background: #f8f8fc; }
        .back-link { color: #007aff; text-decoration: none; font-weight: 500; }
        .back-link:hover { text-decoration: underline; }
        .trigger-icon { font-size: 20px; margin-right: 8px; }
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 20px; }
        .stat-card { background: #f8f8fc; border-radius: 12px; padding: 16px; text-align: center; }
        .stat-card .number { font-size: 24px; font-weight: 700; color: #1c1c1e; }
        .stat-card .label { color: #8e8e93; font-size: 12px; }
        .btn-sm { padding: 4px 12px; font-size: 12px; border-radius: 8px; border: none; cursor: pointer; }
        .btn-danger { background: #ff3b30; color: white; }
        .btn-danger:hover { background: #e0352b; }
        .btn-secondary { background: #e5e5ea; color: #1c1c1e; }
        .btn-success { background: #34c759; color: white; }
        @media (max-width: 768px) { .header { flex-direction: column; align-items: flex-start; } }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-trophy"></i> Достижения</h1>
            <a href="/dashboard" class="back-link">← Вернуться в дашборд</a>
        </div>

        <div class="stat-grid">
            <div class="stat-card">
                <div class="number">{{ stats.total }}</div>
                <div class="label">Всего достижений</div>
            </div>
            <div class="stat-card">
                <div class="number">{{ stats.active }}</div>
                <div class="label">Активных</div>
            </div>
            <div class="stat-card">
                <div class="number">{{ stats.trigger_types|length }}</div>
                <div class="label">Типов триггеров</div>
            </div>
        </div>

        {% for trigger_type, promos in grouped.items() %}
        <div class="card">
            <div class="card-header" onclick="toggleCard(this)">
                <span>
                    <span class="trigger-icon">
                        {% if trigger_type == 'referrals' %}👥
                        {% elif trigger_type == 'purchases' %}🛒
                        {% elif trigger_type == 'subscription_days' %}📅
                        {% elif trigger_type == 'first_payment' %}💳
                        {% else %}🎯
                        {% endif %}
                    </span>
                    <b>
                        {% if trigger_type == 'referrals' %}Рефералы
                        {% elif trigger_type == 'purchases' %}Покупки
                        {% elif trigger_type == 'subscription_days' %}Дни подписки
                        {% elif trigger_type == 'first_payment' %}Первая оплата
                        {% else %}{{ trigger_type }}
                        {% endif %}
                    </b>
                    <span style="color:#8e8e93; font-size:14px; font-weight:400; margin-left:12px;">
                        {{ promos|length }} достижений
                    </span>
                </span>
                <span class="toggle-icon open">▼</span>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th>Код</th>
                            <th>Скидка</th>
                            <th>Цель</th>
                            <th>Использовано</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for promo in promos %}
                        <tr>
                            <td><code>{{ promo.code }}</code></td>
                            <td>
                                {% if promo.discount_percent > 0 %}{{ promo.discount_percent }}%{% endif %}
                                {% if promo.discount_amount > 0 %}{{ promo.discount_amount }}₽{% endif %}
                            </td>
                            <td>{{ promo.target }}</td>
                            <td>{{ promo.used_count }}/{{ promo.max_uses }}</td>
                            <td>
                                {% if promo.is_active %}
                                <span class="badge badge-success">✅ Активно</span>
                                {% else %}
                                <span class="badge badge-warning">⏸ Неактивно</span>
                                {% endif %}
                            </td>
                            <td>
                                <form method="POST" action="/achievements/toggle/{{ promo.id }}" style="display:inline;">
                                    <button type="submit" class="btn-sm {% if promo.is_active %}btn-secondary{% else %}btn-success{% endif %}">
                                        {% if promo.is_active %}⏸ Выключить{% else %}▶ Включить{% endif %}
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endfor %}

        <div class="card">
            <div class="card-header" onclick="toggleCard(this)">
                <span>📋 Описание типов достижений</span>
                <span class="toggle-icon">▼</span>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr><th>Тип</th><th>Описание</th><th>Бонус</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>👥 Рефералы</td><td>Приглашайте друзей по реферальной ссылке</td><td>Промокод на скидку</td></tr>
                        <tr><td>🛒 Покупки</td><td>Оплачивайте подписки в боте</td><td>Промокод на скидку</td></tr>
                        <tr><td>📅 Дни подписки</td><td>Суммарное время с активной подпиской</td><td>Промокод на скидку</td></tr>
                        <tr><td>💳 Первая оплата</td><td>Совершите первую покупку</td><td>Промокод на скидку</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function toggleCard(header) {
            const body = header.nextElementSibling;
            const icon = header.querySelector('.toggle-icon');
            if (body.classList.contains('collapsed')) {
                body.classList.remove('collapsed');
                icon.classList.add('open');
            } else {
                body.classList.add('collapsed');
                icon.classList.remove('open');
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</body>
</html>
{% endblock %}
