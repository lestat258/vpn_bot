        'text_welcome': '🎉 Приветственное',
        'text_install_vpn': '📥 Установить VPN',
        'text_android_instruction': '🤖 Android инструкция',
        'text_ios_instruction': '🍏 iOS инструкция',
        'text_windows_instruction': '💻 Windows инструкция',
        'text_faq': '❓ Вопросы (FAQ)'
