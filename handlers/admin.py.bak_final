    if not tax_enabled:
        text += "⚠️ Интеграция отключена."
    elif not has_password:
        text += "⚠️ Не установлен пароль от «Мой налог»."
    else:
        text += "✅ Всё готово к работе!"

    kb = get_back_keyboard("admin_tax")

    await callback.message.edit_text(
        text,
        reply_markup=kb,
        parse_mode="HTML"
    )
    await callback.answer()

