@router.callback_query(F.data.startswith("admin_extend_key_"))
async def admin_extend_key_start(callback: types.CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return

    sub_id = int(callback.data.replace("admin_extend_key_", ""))
    extend_temp[callback.from_user.id] = sub_id

    await callback.message.answer(
        "📅 <b>Продление ключа</b>\n\n"
        "Введите количество дней для продления (числом):\n"
        "(или отправьте 0 для отмены)",
        parse_mode="HTML"
    )
    await callback.answer()

    try:
        await callback.message.delete()
    except:
        pass

@router.message()
async def admin_extend_key_process(message: types.Message):
    if message.from_user.id not in extend_temp:
        return

    try:
        days = int(message.text)
        sub_id = extend_temp.pop(message.from_user.id)

        if days <= 0:
            await message.answer("❌ Операция отменена")
            return

        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute('SELECT end_date, xui_email, telegram_id FROM subscriptions WHERE id = ?', (sub_id,))
        sub = c.fetchone()

        if not sub:
            await message.answer("❌ Подписка не найдена")
            conn.close()
            return

        end_date, xui_email, user_id = sub
        new_end_date = datetime.fromisoformat(end_date) + timedelta(days=days)

        c.execute('UPDATE subscriptions SET end_date = ? WHERE id = ?', (new_end_date.isoformat(), sub_id))
        conn.commit()
        conn.close()

        best_server = server_manager.get_best_server()
        if best_server:
            xui = XUIClient(url=best_server['url'], api_token=best_server['api_token'])
            xui.update_client_expiry(xui_email, int(new_end_date.timestamp() * 1000))

        await message.answer(
            f"✅ Ключ продлён на <b>{days} дн.</b>\n\n"
            f"Новая дата: <b>{new_end_date.strftime('%d.%m.%Y')}</b>",
            parse_mode="HTML"
        )

        await admin_list_keys_for_user_prepared(message, user_id)

    except ValueError:
        await message.answer("❌ Введите число")
    except Exception as e:
        logging.error(f"❌ Ошибка продления: {e}")
        await message.answer(f"❌ Ошибка: {e}")

async def admin_list_keys_for_user_prepared(message, user_id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        SELECT s.id, t.name, s.end_date, s.is_active
        FROM subscriptions s
        JOIN tariffs t ON t.id = s.tariff_id
        WHERE s.telegram_id = ?
        ORDER BY s.end_date DESC
    ''', (user_id,))
    subs = c.fetchall()
    conn.close()

    if not subs:
        kb = types.InlineKeyboardMarkup(inline_keyboard=[
            [types.InlineKeyboardButton(text="➕ Добавить ключ", callback_data=f"user_add_key_{user_id}")],
            [types.InlineKeyboardButton(text="🔙 Назад", callback_data=f"user_back_to_{user_id}")]
        ])
        await message.answer(
            "🔑 <b>У пользователя нет ключей</b>",
            reply_markup=kb,
            parse_mode="HTML"
        )
        return

    await message.answer(
        f"🔑 <b>Ключи пользователя</b>\n\nВыберите ключ для управления:",
        reply_markup=get_user_keys_admin_keyboard(user_id),
        parse_mode="HTML"
    )

# ============ АДМИН: УДАЛЕНИЕ КЛЮЧА ============

@router.callback_query(F.data.startswith("admin_delete_key_confirm_"))
async def admin_delete_key_confirm(callback: types.CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return

    parts = callback.data.split("|")
    sub_id = int(parts[0].replace("admin_delete_key_confirm_", ""))
    user_id = int(parts[1]) if len(parts) > 1 else None

    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        SELECT s.id, s.telegram_id, s.xui_email, s.xui_client_uid, t.name, u.first_name
        FROM subscriptions s
        JOIN users u ON u.telegram_id = s.telegram_id
        JOIN tariffs t ON t.id = s.tariff_id
        WHERE s.id = ?
    ''', (sub_id,))
    sub = c.fetchone()
    conn.close()

    if not sub:
        await callback.message.edit_text("❌ Подписка не найдена")
        await callback.answer()
        return

    sub_id, user_id_db, email, client_uid, tariff_name, first_name = sub
    user_id = user_id_db or user_id

    kb = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="✅ Да, удалить", callback_data=f"admin_delete_execute_{sub_id}|{user_id}")],
        [types.InlineKeyboardButton(text="🔙 Назад", callback_data=f"user_list_keys_{user_id}")]
    ])

    await callback.message.edit_text(
        f"⚠️ <b>Удаление подписки</b>\n\n"
        f"👤 Пользователь: {first_name or user_id} ({user_id})\n"
        f"📦 Тариф: {tariff_name}\n"
        f"🔑 Email: {email}\n\n"
        f"<b>ВНИМАНИЕ!</b> Ключ будет удалён из панели 3X-UI.\n\n"
        f"Вы уверены?",
        reply_markup=kb,
        parse_mode="HTML"
    )
    await callback.answer()

@router.callback_query(F.data.startswith("admin_delete_execute_"))
async def admin_delete_key_execute(callback: types.CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return

    parts = callback.data.split("|")
    sub_id = int(parts[0].replace("admin_delete_execute_", ""))
    user_id = int(parts[1]) if len(parts) > 1 else None

    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('SELECT telegram_id, xui_email FROM subscriptions WHERE id = ?', (sub_id,))
    sub = c.fetchone()

    if not sub:
        await callback.message.edit_text("❌ Подписка не найдена")
        await callback.answer()
        return

    telegram_id, email = sub
    telegram_id = telegram_id or user_id

    best_server = server_manager.get_best_server()
    if best_server:
        xui = XUIClient(url=best_server['url'], api_token=best_server['api_token'])
        xui.delete_client(email)

    c.execute('UPDATE subscriptions SET is_active = 0 WHERE id = ?', (sub_id,))
    conn.commit()
    conn.close()

    try:
        await callback.bot.send_message(
            chat_id=telegram_id,
            text="⚠️ <b>Ваша подписка была удалена администратором.</b>\n\n"
                 "Для получения нового ключа обратитесь в поддержку.",
            parse_mode="HTML"
        )
    except Exception as e:
        logging.error(f"Failed to notify user: {e}")

    await callback.answer("✅ Ключ удалён", show_alert=True)
    await admin_list_keys_for_user(callback)

# ============ УПРАВЛЕНИЕ ЛИМИТАМИ ============

@router.message(Command("limits"))
async def show_limits(message: types.Message):
    """Показывает текущие лимиты пользователя (для админа)"""
    if message.from_user.id != ADMIN_ID:
        await message.answer("⛔ Доступ запрещён")
        return
    
    from rate_limiter import rate_limiter
    
    # Если указан ID пользователя
    parts = message.text.split()
    if len(parts) > 1:
        try:
            user_id = int(parts[1])
            status = rate_limiter.get_user_status(user_id)
            text = f"📊 <b>Статус пользователя {user_id}</b>\n\n"
            for action_type, data in status.items():
                text += f"📌 {action_type}:\n"
                text += f"   Запросов: {data['count']}\n"
                text += f"   Заблокирован: {'✅' if data['is_blocked'] else '❌'}\n"
                if data['blocked_until']:
                    text += f"   До: {data['blocked_until'][:16]}\n"
                text += "\n"
            await message.answer(text, parse_mode="HTML")
            return
        except:
            pass
    
    # Показываем свои лимиты
    status = rate_limiter.get_user_status(message.from_user.id)
    text = "📊 <b>Ваши лимиты</b>\n\n"
    for action_type, data in status.items():
        text += f"📌 {action_type}:\n"
        text += f"   Запросов: {data['count']}\n"
        text += f"   Заблокирован: {'✅' if data['is_blocked'] else '❌'}\n"
        if data['blocked_until']:
            text += f"   До: {data['blocked_until'][:16]}\n"
        text += "\n"
    await message.answer(text, parse_mode="HTML")

@router.message(Command("reset_limits"))
async def reset_limits(message: types.Message):
    """Сбрасывает лимиты пользователя (для админа)"""
    if message.from_user.id != ADMIN_ID:
        await message.answer("⛔ Доступ запрещён")
        return
    
    from rate_limiter import rate_limiter
    
    parts = message.text.split()
    if len(parts) < 2:
        await message.answer("❌ Укажите ID пользователя: /reset_limits 123456789")
        return
    
    try:
        user_id = int(parts[1])
        rate_limiter.reset_limits(user_id)
        await message.answer(f"✅ Лимиты сброшены для пользователя {user_id}")
    except ValueError:
        await message.answer("❌ Укажите корректный ID")

# ============ УПРАВЛЕНИЕ ЗАЩИТОЙ ОТ СПАМА ============

@router.callback_query(F.data == "admin_rate_limit")
async def admin_rate_limit_menu(callback: types.CallbackQuery):
    """Меню управления защитой от спама"""
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return
    
    from rate_limiter import rate_limiter
    
    # Получаем статистику
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # Общее количество заблокированных пользователей
    c.execute('SELECT COUNT(DISTINCT user_id) FROM rate_limits WHERE is_blocked = 1')
    blocked_count = c.fetchone()[0]
    
    # Количество записей в таблице
    c.execute('SELECT COUNT(*) FROM rate_limits')
    total_records = c.fetchone()[0]
    
    conn.close()
    
    kb = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="📊 Статистика", callback_data="rate_limit_stats")],
        [types.InlineKeyboardButton(text="🔓 Снять блокировку", callback_data="rate_limit_unblock")],
        [types.InlineKeyboardButton(text="⚙️ Настройки", callback_data="rate_limit_settings")],
        [types.InlineKeyboardButton(text="🔙 Назад", callback_data="admin_back_to_menu")]
    ])
    
    await callback.message.edit_text(
        f"🛡️ <b>Защита от спама и брутфорса</b>\n\n"
        f"📊 Заблокировано пользователей: {blocked_count}\n"
        f"📋 Всего записей в БД: {total_records}\n\n"
        f"Выберите действие:",
        reply_markup=kb,
        parse_mode="HTML"
    )
    await callback.answer()

@router.callback_query(F.data == "rate_limit_stats")
async def rate_limit_stats(callback: types.CallbackQuery):
    """Показывает статистику по лимитам"""
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # Статистика по типам действий
    c.execute('''
        SELECT action_type, COUNT(*), SUM(request_count), COUNT(CASE WHEN is_blocked = 1 THEN 1 END)
        FROM rate_limits
        GROUP BY action_type
    ''')
    stats = c.fetchall()
    
    conn.close()
    
    text = "📊 <b>Статистика по типам действий</b>\n\n"
    for action_type, count, total_requests, blocked in stats:
        text += f"📌 <b>{action_type}</b>\n"
        text += f"   Пользователей: {count}\n"
        text += f"   Всего запросов: {total_requests}\n"
        text += f"   Заблокировано: {blocked}\n\n"
    
    kb = get_back_keyboard("admin_rate_limit")
    
    await callback.message.edit_text(
        text,
        reply_markup=kb,
        parse_mode="HTML"
    )
    await callback.answer()

@router.callback_query(F.data == "rate_limit_unblock")
async def rate_limit_unblock_menu(callback: types.CallbackQuery):
    """Меню снятия блокировки"""
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    c.execute('''
        SELECT DISTINCT user_id, blocked_until
        FROM rate_limits
        WHERE is_blocked = 1
        ORDER BY blocked_until DESC
        LIMIT 20
    ''')
    blocked_users = c.fetchall()
    
    conn.close()
    
    if not blocked_users:
        await callback.message.edit_text(
            "✅ Нет заблокированных пользователей",
            reply_markup=get_back_keyboard("admin_rate_limit"),
            parse_mode="HTML"
        )
        await callback.answer()
        return
    
    buttons = []
    for user_id, blocked_until in blocked_users:
        # Получаем имя пользователя
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute('SELECT first_name, username FROM users WHERE telegram_id = ?', (user_id,))
        user = c.fetchone()
        conn.close()
        
        name = user[0] or user[1] or str(user_id) if user else str(user_id)
        until = blocked_until[:16] if blocked_until else "неизвестно"
        
        buttons.append([types.InlineKeyboardButton(
            text=f"🔓 {name} ({user_id}) — до {until}",
            callback_data=f"rate_unblock_{user_id}"
        )])
    
    buttons.append([types.InlineKeyboardButton(text="🔙 Назад", callback_data="admin_rate_limit")])
    
    await callback.message.edit_text(
        "🔓 <b>Заблокированные пользователи</b>\n\n"
        "Выберите пользователя для снятия блокировки:",
        reply_markup=types.InlineKeyboardMarkup(inline_keyboard=buttons),
        parse_mode="HTML"
    )
    await callback.answer()

@router.callback_query(F.data.startswith("rate_unblock_"))
async def rate_limit_unblock_user(callback: types.CallbackQuery):
    """Снимает блокировку с пользователя"""
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return
    
    user_id = int(callback.data.replace("rate_unblock_", ""))
    
    from rate_limiter import rate_limiter
    rate_limiter.reset_limits(user_id)
    
    await callback.answer(f"✅ Блокировка снята с пользователя {user_id}", show_alert=True)
    await rate_limit_unblock_menu(callback)

@router.callback_query(F.data == "rate_limit_settings")
async def rate_limit_settings(callback: types.CallbackQuery):
    """Настройки лимитов"""
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return
    
    from rate_limiter import rate_limiter
    
    text = "⚙️ <b>Настройки лимитов</b>\n\n"
    for action_type, limits in rate_limiter.limits.items():
        text += f"📌 <b>{action_type}</b>\n"
        text += f"   Макс. запросов: {limits['max_requests']}\n"
        text += f"   Окно (сек): {limits['time_window']}\n"
        text += f"   Блокировка (сек): {limits['block_duration']}\n\n"
    
    text += "Для изменения настроек отредактируйте файл rate_limiter.py\n"
    text += "и перезапустите бота."
    
    kb = get_back_keyboard("admin_rate_limit")
    
    await callback.message.edit_text(
        text,
        reply_markup=kb,
        parse_mode="HTML"
    )
    await callback.answer()

