@router.callback_query(F.data == "admin_broadcast_promo")
async def admin_broadcast_promo_menu(callback: types.CallbackQuery):
    """Меню рассылки промокодов с разделением на достижения и ручные"""
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ Доступ запрещён")
        return
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    c.execute('''
        SELECT code, discount_percent, trigger_type 
        FROM promocodes 
        WHERE trigger_type != 'manual' AND is_active = 1 
        ORDER BY trigger_type, code
    ''')
    achievement_promos = c.fetchall()
    
    c.execute('''
        SELECT code, discount_percent 
        FROM promocodes 
        WHERE trigger_type = 'manual' AND is_active = 1 
        ORDER BY created_at DESC
    ''')
    manual_promos = c.fetchall()
    conn.close()
    
    buttons = []
    
    if achievement_promos:
        buttons.append([types.InlineKeyboardButton(
            text="🏆 ДОСТИЖЕНИЯ",
            callback_data="noop"
        )])
        for code, discount, trigger_type in achievement_promos:
            icons = {
                'referrals': '👥',
                'purchases': '🛒',
                'subscription_days': '📅',
                'first_payment': '💳'
            }
            icon = icons.get(trigger_type, '🎯')
            buttons.append([types.InlineKeyboardButton(
                text=f"{icon} {code} ({discount}%)",
                callback_data=f"broadcast_promo_{code}"
            )])
    
    if achievement_promos and manual_promos:
        buttons.append([types.InlineKeyboardButton(
            text="─────────────",
            callback_data="noop"
        )])
    
    if manual_promos:
        buttons.append([types.InlineKeyboardButton(
            text="✋ РУЧНЫЕ",
            callback_data="noop"
        )])
        for code, discount in manual_promos:
            buttons.append([types.InlineKeyboardButton(
                text=f"📌 {code} ({discount}%)",
                callback_data=f"broadcast_promo_{code}"
            )])
    
    if not achievement_promos and not manual_promos:
        await callback.message.edit_text(
            "📢 <b>Рассылка промокодов</b>\n\n"
            "❌ Нет активных промокодов для рассылки.",
            reply_markup=get_back_keyboard("admin_back_to_menu"),
            parse_mode="HTML"
        )
        await callback.answer()
        return
    
    buttons.append([types.InlineKeyboardButton(
        text="🔙 Назад",
        callback_data="admin_back_to_menu"
    )])
    
    text = "📢 <b>Рассылка промокодов</b>\n\n"
    if achievement_promos:
        text += f"🏆 Достижения: {len(achievement_promos)}\n"
    if manual_promos:
        text += f"✋ Ручные: {len(manual_promos)}\n"
    text += "\nВыберите промокод для рассылки:"
    
    kb = types.InlineKeyboardMarkup(inline_keyboard=buttons)
    await callback.message.edit_text(text, reply_markup=kb, parse_mode="HTML")
    await callback.answer()
async def broadcast_send_promo(callback: types.CallbackQuery):
    """Отправка рассылки с промокодом"""
    code = callback.data.replace("broadcast_send_", "").upper()
    
    logging.info(f"🚀 Отправка рассылки промокода: {code}")
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        SELECT code, discount_percent, discount_amount, valid_until, max_uses, used_count 
        FROM promocodes 
        WHERE code = ? AND is_active = 1
    ''', (code,))
    promo = c.fetchone()
    conn.close()
    
    if not promo:
        await callback.answer("❌ Промокод не найден", show_alert=True)
        return
    
    code, discount_percent, discount_amount, valid_until, max_uses, used_count = promo
    
    if discount_percent > 0:
        discount_text = f"{discount_percent}%"
    else:
        discount_text = f"{discount_amount}₽"
    valid_text = valid_until[:10] if valid_until else "бессрочно"
    remaining = max_uses - used_count
    
    message_text = (
        f"🎉 <b>Новый промокод!</b>\n\n"
        f"У нас для вас отличная новость — новый промокод на скидку!\n\n"
        f"🏷️ <b>ПРОМОКОД: {code}</b>\n"
        f"🎁 <b>Скидка: {discount_text}</b>\n"
        f"📅 <b>Действует до: {valid_text}</b>\n"
        f"📊 <b>Осталось использований: {remaining}</b>\n\n"
        f"💡 <b>Как использовать?</b>\n"
        f"1. Перейдите в «🎫 Промокоды и достижения» в профиле\n"
        f"2. Нажмите «🏷️ Ввести промокод»\n"
        f"3. Введите код: <b>{code}</b>\n\n"
        f"Не упустите возможность сэкономить! 🚀"
    )
    
    await callback.message.edit_text("⏳ Отправка рассылки...", parse_mode="HTML")
    
    from broadcast import send_broadcast_with_text
    sent_count = await send_broadcast_with_text(message_text)
    
    await callback.message.edit_text(
        f"✅ <b>Рассылка завершена!</b>\n\n"
        f"📨 Отправлено: {sent_count} пользователям\n"
        f"🏷️ Промокод: {code}\n"
        f"🎁 Скидка: {discount_text}",
        reply_markup=get_back_keyboard("admin_back_to_menu"),
        parse_mode="HTML"
    )
    await callback.answer()

@router.callback_query(F.data.startswith("broadcast_promo_"))
async def broadcast_promo_confirm(callback: types.CallbackQuery):
    """Подтверждение рассылки промокода"""
    code = callback.data.replace("broadcast_promo_", "")
    
    logging.info(f"🔍 Выбран промокод: {code}")
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        SELECT code, discount_percent, discount_amount, valid_until, max_uses, used_count 
        FROM promocodes 
        WHERE upper(code) = upper(?) AND is_active = 1
    ''', (code,))
    promo = c.fetchone()
    conn.close()
    
    if not promo:
        await callback.answer("❌ Промокод не найден", show_alert=True)
        return
    
    code, discount_percent, discount_amount, valid_until, max_uses, used_count = promo
    
    if discount_percent > 0:
        discount_text = f"{discount_percent}%"
    else:
        discount_text = f"{discount_amount}₽"
    valid_text = valid_until[:10] if valid_until else "бессрочно"
    remaining = max_uses - used_count
    
    text = f"📢 <b>Рассылка промокода</b>\n\n"
    text += f"🏷️ <b>{code}</b>\n"
    text += f"🎁 Скидка: {discount_text}\n"
    text += f"📅 Действует до: {valid_text}\n"
    text += f"📊 Осталось: {remaining}/{max_uses}\n\n"
    text += "Отправить сообщение всем пользователям?"
    
    kb = types.InlineKeyboardMarkup(inline_keyboard=[
        [types.InlineKeyboardButton(text="✅ Да, отправить", callback_data=f"broadcast_send_{code}")],
        [types.InlineKeyboardButton(text="❌ Отмена", callback_data="admin_broadcast_promo")]
    ])
    
    await callback.message.edit_text(text, reply_markup=kb, parse_mode="HTML")
    await callback.answer()

@router.callback_query(F.data.startswith("broadcast_send_"))
async def broadcast_send_promo(callback: types.CallbackQuery):
    """Отправка рассылки с промокодом"""
    code = callback.data.replace("broadcast_send_", "")
    
    logging.info(f"🚀 Отправка рассылки для промокода: {code}")
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        SELECT code, discount_percent, discount_amount, valid_until, max_uses, used_count 
        FROM promocodes 
        WHERE upper(code) = upper(?) AND is_active = 1
    ''', (code,))
    promo = c.fetchone()
    conn.close()
    
    if not promo:
        logging.error(f"❌ Промокод {code} не найден")
        await callback.answer("❌ Промокод не найден", show_alert=True)
        return
    
    code, discount_percent, discount_amount, valid_until, max_uses, used_count = promo
    logging.info(f"✅ Промокод найден: {code}")
    
    if discount_percent > 0:
        discount_text = f"{discount_percent}%"
    else:
        discount_text = f"{discount_amount}₽"
    valid_text = valid_until[:10] if valid_until else "бессрочно"
    remaining = max_uses - used_count
    
    message_text = (
        f"🎉 <b>Новый промокод!</b>\n\n"
        f"🏷️ <b>ПРОМОКОД: {code}</b>\n"
        f"🎁 <b>Скидка: {discount_text}</b>\n"
        f"📅 <b>Действует до: {valid_text}</b>\n"
        f"📊 <b>Осталось: {remaining}</b>\n\n"
        f"💡 Введите код в разделе «🎫 Промокоды и достижения»"
    )
    
    await callback.message.edit_text("⏳ Отправка рассылки...", parse_mode="HTML")
    
    try:
        from broadcast import send_broadcast_with_text
        sent_count = await send_broadcast_with_text(message_text)
        
        await callback.message.edit_text(
            f"✅ <b>Рассылка завершена!</b>\n\n"
            f"📨 Отправлено: {sent_count} пользователям\n"
            f"🏷️ Промокод: {code}\n"
            f"🎁 Скидка: {discount_text}",
            reply_markup=get_back_keyboard("admin_back_to_menu"),
            parse_mode="HTML"
        )
    except Exception as e:
        logging.error(f"❌ Ошибка отправки: {e}")
        await callback.message.edit_text(
            f"❌ <b>Ошибка отправки</b>\n\n{str(e)}",
            reply_markup=get_back_keyboard("admin_back_to_menu"),
            parse_mode="HTML"
        )
    
    await callback.answer()
